# --- Server-only secrets (never use VITE_ prefix) ---
# Vite dev proxy + Vercel /api/* inject these; they are NOT shipped to the browser.

# RapidAPI (flight schedules)
#   /api/timetable-lookup → TimeTable Lookup
#   /api/aerodatabox      → AeroDataBox fallback
RAPIDAPI_KEY=

# OpenAI-compatible LLM (required for itinerary / chat)
OPENAI_API_KEY=
# Optional custom base (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Gemini (only if you re-enable provider switch)
# GEMINI_API_KEY=

# --- Browser-safe (VITE_) ---
# Google Maps MUST load in the browser. Restrict this key in Google Cloud:
#   Application = HTTP referrers → https://paristour.vercel.app/* and http://127.0.0.1:5173/*
VITE_GOOGLE_MAPS_API_KEY=

# Public (not secret): which chat model id the UI defaults to
# VITE_OPENAI_MODEL=gpt-5.6-luna

# Set to false to hide LLM features in the UI
# VITE_LLM_ENABLED=true
