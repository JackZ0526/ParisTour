# --- Server-only secrets (never use VITE_ prefix) ---
# Vite dev proxy + Vercel /api/* inject these; they are NOT shipped to the browser.

# RapidAPI (flight schedules + optional Google Map Places)
#   /api/timetable-lookup → TimeTable Lookup
#   /api/aerodatabox      → AeroDataBox fallback
#   /api/google-places    → RapidAPI Google Map Places when GOOGLE_PLACES_PROVIDER=rapidapi
RAPIDAPI_KEY=
# Optional override; the default matches the subscribed RapidAPI product.
# RAPIDAPI_GOOGLE_PLACES_HOST=google-map-places-new-v2.p.rapidapi.com
# RAPIDAPI_GOOGLE_PLACES_BACKUP_HOST=google-map-places.p.rapidapi.com

# Places data provider for /api/google-places. Client code is unchanged.
#   official  → places.googleapis.com (Places API New). Requires GOOGLE_PLACES_API_KEY.
#   rapidapi  → RapidAPI New V2 + legacy backup (default).
# GOOGLE_PLACES_PROVIDER=official
# Server-only Places key. Do NOT reuse VITE_GOOGLE_MAPS_API_KEY (HTTP-referrer restricted).
# Enable Places API (New). Restrict by IP or leave unrestricted for local Node.
# GOOGLE_PLACES_API_KEY=
# Booking COM hotel data. Keep disabled until the final API-key verification.
# RAPIDAPI_BOOKING_HOST=booking-com18.p.rapidapi.com
# Browser-safe kill switch; false/omitted means zero Booking API requests.
# VITE_BOOKING_API_ENABLED=false

# openrouteservice / HeiGIT Directions (server-only; map road geometry)
# Create a free Standard key at https://account.heigit.org/
OPENROUTESERVICE_API_KEY=

# OpenAI-compatible LLM (required for itinerary / chat)
OPENAI_API_KEY=
# Optional custom base (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (OpenAI-compatible; preferred default when set)
# Server-only — do NOT use a VITE_ prefix for the key.
DEEPSEEK_API_KEY=
# Optional custom base (default https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional Gemini (only if you re-enable provider switch)
# GEMINI_API_KEY=

# Supabase (server auth for paid /api proxies on Vercel)
# Prefer the same project values as VITE_* below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only: used to send share invites via Supabase Auth email when Resend is unset
SUPABASE_SERVICE_ROLE_KEY=

# Share-invite emails (Resend). Requires a verified domain to email arbitrary recipients.
# Marketplace install needs a domain you own on Vercel. Prefer SERVICE_ROLE fallback above if none.
# https://resend.com/api-keys
RESEND_API_KEY=
# e.g. Paris Tour <invites@yourdomain.com>
RESEND_FROM_EMAIL=
# Canonical site URL used in invite links (optional; falls back to request Origin)
PUBLIC_APP_URL=https://paristour.vercel.app

# --- Browser-safe (VITE_) ---
# Supabase Auth + Postgres (invite-only login, trip archive, sharing)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dev test account (after schema + `npm run seed:test-user`):
#   email: test@paristour.dev  (login field also accepts "test")
#   password: test

# Optional browser key for official Google Places photo media / legacy place embed only.
# The itinerary map does not use Maps JavaScript API.
# Restrict this key in Google Cloud:
#   Application = HTTP referrers → include ALL of:
#     http://127.0.0.1:5173/*
#     http://localhost:5173/*
#     https://paristour.vercel.app/*
VITE_GOOGLE_MAPS_API_KEY=

# Public (not secret): which chat model id the UI defaults to.
# DeepSeek is preferred when both providers are configured.
# Official DeepSeek ids: deepseek-v4-flash | deepseek-v4-pro
# VITE_DEEPSEEK_MODEL=deepseek-v4-flash
# VITE_DEEPSEEK_MODEL=deepseek-v4-pro
# VITE_OPENAI_MODEL=gpt-5.6-luna

# Set to false to hide LLM features in the UI
# VITE_LLM_ENABLED=true
