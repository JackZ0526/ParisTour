# AviationStack key for live flight lookup
VITE_AVIATIONSTACK_KEY=

# RapidAPI key (server-side only — never use VITE_ prefix)
# Used by Vite proxies:
#   /api/timetable-lookup → https://timetable-lookup.p.rapidapi.com  (primary flight schedules)
#   /api/aerodatabox      → https://aerodatabox.p.rapidapi.com       (fallback)
# Subscribe on RapidAPI, then paste X-RapidAPI-Key here.
RAPIDAPI_KEY=


# Google Maps (Maps JavaScript API + Places + Directions / Routes)
VITE_GOOGLE_MAPS_API_KEY=

# Optional LLM for place blurbs + day titles (prefer Gemini)
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Or OpenAI-compatible (OpenAI / DeepSeek / etc.)
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# VITE_OPENAI_MODEL=gpt-5.6-luna
