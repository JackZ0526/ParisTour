# --- Server-only secrets (never use VITE_ prefix) ---
# Vite dev proxy + Vercel /api/* inject these; they are NOT shipped to the browser.

# RapidAPI (flight schedules)
#   /api/timetable-lookup → TimeTable Lookup
#   /api/aerodatabox      → AeroDataBox fallback
RAPIDAPI_KEY=

# OpenAI-compatible LLM (required for itinerary / chat)
OPENAI_API_KEY=
# Optional custom base (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (OpenAI-compatible; preferred default when set)
# Server-only — do NOT use a VITE_ prefix for the key.
DEEPSEEK_API_KEY=
# Optional custom base (default https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional Gemini (only if you re-enable provider switch)

# Supabase (server auth for paid /api proxies on Vercel)
# Prefer the same project values as VITE_* below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only: used to send share invites via Supabase Auth email when Resend is unset
SUPABASE_SERVICE_ROLE_KEY=

# Share-invite emails (Resend). Requires a verified domain to email arbitrary recipients.
# Marketplace install needs a domain you own on Vercel. Prefer SERVICE_ROLE fallback above if none.
# https://resend.com/api-keys
RESEND_API_KEY=
# e.g. Paris Tour <invites@yourdomain.com>
RESEND_FROM_EMAIL=
# Canonical site URL used in invite links (optional; falls back to request Origin)
PUBLIC_APP_URL=https://paristour.vercel.app

# --- Browser-safe (VITE_) ---
# Supabase Auth + Postgres (invite-only login, trip archive, sharing)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dev test account (after schema + `npm run seed:test-user`):
#   email: test@paristour.dev  (login field also accepts "test")
#   password: test

# Free OpenRouteService account key. Kept server-side by the local/Vercel proxy.
# When absent, walking/driving routes fall back to the public OSM routing demo.
OPENROUTESERVICE_API_KEY=

# Public (not secret): which chat model id the UI defaults to.
# DeepSeek is preferred when both providers are configured.
# Official DeepSeek ids: deepseek-v4-flash | deepseek-v4-pro
# VITE_DEEPSEEK_MODEL=deepseek-v4-flash
# VITE_DEEPSEEK_MODEL=deepseek-v4-pro
# VITE_OPENAI_MODEL=gpt-5.6-luna

# Set to false to hide LLM features in the UI
# VITE_LLM_ENABLED=true
