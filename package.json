{
  "name": "paristour",
  "private": true,
  "version": "0.9.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-lucide-icons.mjs",
    "lint:icons": "node scripts/check-lucide-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:no-void-type": "node scripts/_no-void-type.mjs",
    "check:prompts": "node scripts/check-prompt-contracts.mjs",
    "seed:test-user": "node scripts/seed-test-user.mjs",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepare": "husky install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "husky": "^9.0.11",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
