{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/timetable-lookup/(.*)",
      "destination": "/api/timetable-lookup?rest=$1"
    },
    {
      "source": "/api/aerodatabox/(.*)",
      "destination": "/api/aerodatabox?rest=$1"
    },
    {
      "source": "/api/gemini/(.*)",
      "destination": "/api/gemini?rest=$1"
    },
    {
      "source": "/api/openai/(.*)",
      "destination": "/api/openai?rest=$1"
    },
    {
      "source": "/api/deepseek/(.*)",
      "destination": "/api/deepseek?rest=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
